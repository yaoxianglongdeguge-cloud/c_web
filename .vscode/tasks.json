{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-g",
                "-fdiagnostics-color=always",
                "-o",
                "${workspaceFolder}/main",
                "${workspaceFolder}/main.c",
                "${workspaceFolder}/server/accept_conn.c",
                "${workspaceFolder}/server/driver.c",
                "${workspaceFolder}/memory_pool/memory_pool.c",
                "${workspaceFolder}/data_struct/hash_2.c",
                "${workspaceFolder}/data_struct/hash_1.c",
                "${workspaceFolder}/timer/timer.c",
                "${workspaceFolder}/send_tool/send_tool.c",
                "${workspaceFolder}/my_thread/worker_thread.c",
                "${workspaceFolder}/my_thread/profession_thread.c",
                "${workspaceFolder}/router/route.c",
                "${workspaceFolder}/http_analysis/http_ed_store.c",
                "${workspaceFolder}/http_analysis/http_analysis.c",
                "${workspaceFolder}/http_analysis/http_main.c",
                "${workspaceFolder}/http_analysis/http_state.c",
                "-lpthread"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc-15 生成活动文件",
            "command": "/usr/bin/gcc-15",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}